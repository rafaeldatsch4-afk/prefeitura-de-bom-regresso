rules_version = '2';

// Regras do banco da República Bom Regressense.
// Todo acesso exige a sessão do Firebase que o próprio site abre ao carregar.
// Só existem as coleções que o app usa; o resto fica fechado.
// Os documentos principais não podem ser apagados (só editados), e há limites de tamanho e de formato.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMap(d) { return d is map; }
    function optString(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    // Uma gravação não pode sumir com muitos itens de uma vez (apagar tudo era possível para qualquer visitante).
    // O app apaga um perfil/estado por vez; um estado leva junto os municípios dele.
    function shrinksAtMost(k, max) {
      return !(k in resource.data) || !(resource.data[k] is list)
        || (k in request.resource.data && request.resource.data[k] is list
            && request.resource.data[k].size() >= resource.data[k].size() - max);
    }

    // República (perfis, estados, municípios, cofre, histórico)
    match /republica/{docId} {
      allow read: if signedIn() && docId == 'dados_v1';
      allow create, update: if signedIn() && docId == 'dados_v1' && isMap(request.resource.data)
        && (!('profiles' in request.resource.data) || request.resource.data.profiles is list)
        && (!('estados' in request.resource.data) || request.resource.data.estados is list)
        && (!('municipios' in request.resource.data) || request.resource.data.municipios is list)
        && (resource == null || (shrinksAtMost('profiles', 3) && shrinksAtMost('estados', 1) && shrinksAtMost('municipios', 60)));
      allow delete: if false;
    }

    // Fotos da República (perfis, estados e municípios), fora do documento principal para ele não passar de 1 MB.
    // Cada foto é guardada uma vez, pelo conteúdo, e não muda depois.
    match /republicaFotos_v1/{photoId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && photoId.size() <= 60
        && request.resource.data.keys().hasOnly(['photo', 'criadoEm'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 400000
        && request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && optString(request.resource.data, 'criadoEm', 40);
      allow update, delete: if false;
    }

    // Sistema completo da Prefeitura de Bom Regresso, da cópia independente (dados_ind1, em /bom-regresso/)
    // e configuração das notificações
    match /municipio/{docId} {
      allow read: if signedIn() && docId in ['dados_v5', 'dados_ind1', 'push_config_v2'];
      allow create, update: if signedIn() && docId in ['dados_v5', 'dados_ind1', 'push_config_v2'] && isMap(request.resource.data)
        && (resource == null || shrinksAtMost('operators', 3));
      allow delete: if false;
    }

    // Sistema completo de cada outro município (um documento por município)
    match /prefeituras_v5/{cityId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && cityId.size() <= 80 && isMap(request.resource.data)
        && (resource == null || shrinksAtMost('operators', 3));
      allow delete: if false;
      match /carriers/{carrierId} {
        allow read: if signedIn();
      allow write: if signedIn() && carrierId.size() <= 120;
      }
    }

    // Transportadoras de Bom Regresso
    match /carriers_v5/{carrierId} {
      allow read: if signedIn();
      allow write: if signedIn() && carrierId.size() <= 120;
    }
    match /carriers_ind1/{carrierId} {
      allow read: if signedIn();
      allow write: if signedIn() && carrierId.size() <= 120;
    }

    // Resumo das senhas (PBKDF2): pode ser lido por id, mas a lista inteira não pode ser baixada
    // (profileSecrets_ind1 é o da cópia independente, com as mesmas regras)
    match /{secrets}/{profileId} {
      allow get: if signedIn() && secrets in ['profileSecrets_v5', 'profileSecrets_ind1'];
      allow list: if false;
      // O aparelho só cria a senha que ainda não existe. Trocar ou redefinir passa pelo servidor (/api/senha),
      // que confere a senha atual ou a de quem tem acesso total. Antes qualquer visitante sobrescrevia a senha de qualquer perfil.
      allow create: if signedIn() && secrets in ['profileSecrets_v5', 'profileSecrets_ind1'] && request.resource.data.hash is string && request.resource.data.salt is string
        && request.resource.data.iterations is int && request.resource.data.iterations >= 100000
        && request.resource.data.hash.size() <= 200 && request.resource.data.salt.size() <= 200;
      allow update, delete: if false;
    }

    // Chat da República (v5) e chat da cópia independente (ind1).
    // Cada mensagem guarda a sessão que a enviou (senderUid): só ela edita ou apaga. Os outros só mexem em reações
    // e na mensagem fixada. Quem tem acesso total apaga as dos outros pelo servidor (/api/chat), com a própria senha.
    function chatFields(d) {
      return optString(d, 'text', 4000) && optString(d, 'senderName', 200) && optString(d, 'senderId', 200);
    }
    match /{chat}/{messageId} {
      allow read: if signedIn() && chat in ['chatMessages_v5', 'chatMessages_ind1'];
      allow create: if signedIn() && chat in ['chatMessages_v5', 'chatMessages_ind1'] && messageId.size() <= 120
        && request.resource.data.get('senderUid', '') == request.auth.uid && chatFields(request.resource.data);
      allow update: if signedIn() && chat in ['chatMessages_v5', 'chatMessages_ind1'] && chatFields(request.resource.data)
        && ((resource.data.get('senderUid', '') == request.auth.uid && request.resource.data.get('senderUid', '') == request.auth.uid)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinnedAt', 'pinnedBy']));
      allow delete: if signedIn() && chat in ['chatMessages_v5', 'chatMessages_ind1']
        && resource.data.get('senderUid', '') == request.auth.uid;
    }
    // Anexos do chat (imagem, áudio, arquivo): mesma regra, pela sessão que enviou (ownerUid). Não mudam depois.
    match /{media}/{mediaId} {
      allow read: if signedIn() && media in ['chatMedia_v5', 'chatMedia_ind1'];
      allow create: if signedIn() && media in ['chatMedia_v5', 'chatMedia_ind1'] && mediaId.size() <= 120
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
      allow delete: if signedIn() && media in ['chatMedia_v5', 'chatMedia_ind1']
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }
    match /{presence}/{profileId} {
      allow read: if signedIn() && presence in ['chatPresence_v5', 'chatPresence_ind1'];
      allow write: if signedIn() && presence in ['chatPresence_v5', 'chatPresence_ind1'] && profileId.size() <= 120;
    }

    // Aparelhos que recebem notificação e registro do sistema municipal
    match /{tokens}/{deviceId} {
      allow read: if signedIn() && tokens in ['pushTokens_v5', 'pushTokens_ind1'];
      allow write: if signedIn() && tokens in ['pushTokens_v5', 'pushTokens_ind1'] && deviceId.size() <= 200;
    }
    match /{registry}/{systemId} {
      allow read: if signedIn() && registry in ['integrationRegistry_v5', 'integrationRegistry_ind1'];
      allow write: if signedIn() && registry in ['integrationRegistry_v5', 'integrationRegistry_ind1'] && systemId.size() <= 120;
    }

    // Projeção 3D de cada município (um documento por município com a lista de construções do mapa)
    match /cidade3d_v1/{cityKey} {
      allow get: if signedIn() && cityKey.size() <= 80;
      allow list: if false;
      allow create, update: if signedIn() && cityKey.size() <= 80 && isMap(request.resource.data)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy', 'cityKey', 'schemaVersion'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 2400
        && optString(request.resource.data, 'updatedAt', 40) && optString(request.resource.data, 'updatedBy', 80)
        && (resource == null || shrinksAtMost('items', 300));
      allow delete: if false;
    }

    // Qualquer outra coleção: fechada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
